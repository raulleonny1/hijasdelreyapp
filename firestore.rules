rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura/escritura solo desde el servidor (Firebase Admin SDK).
    // El cliente no accede directamente a Firestore.
    match /users/{userId} {
      allow read, write: if false;
    }
    match /answers/{answerId} {
      allow read, write: if false;
    }
  }
}
