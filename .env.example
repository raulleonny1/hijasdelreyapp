# Firebase (Consola → Configuración del proyecto → Tus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (elija UNA opción — ver CONFIGURAR-FIREBASE.md)
# Opción A (recomendada en Vercel):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opción B: JSON completo en una línea
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Opción C: JSON en base64 (python scripts/setup-firebase-env.py archivo.json)
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Sesión JWT
AUTH_SECRET=cambie-este-secreto-en-produccion
